{
  "rules": {
    ".read": false,
    ".write": false,

    "public": {
      ".read": true,
      ".write": false
    },

    "news": {
      ".read": true,
      ".write": false
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",

        "status": {
          ".write": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'",
          ".validate": "newData.isString()"
        },

        ".validate": "newData.hasChildren(['uid']) && newData.child('uid').val() === $uid"
      }
    },

    "private_users": {
      "$uid": {
        ".read": false,
        ".write": false,

        "email": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
          ".write": "auth != null && auth.uid === $uid"
        },

        "phone": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
          ".write": "auth != null && auth.uid === $uid"
        },

        "settings": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
          ".write": "auth != null && auth.uid === $uid"
        },

        "legacyIdentifiers": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
          ".write": "auth != null && auth.uid === $uid"
        },

        "kyc": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",
          ".write": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || (auth.uid === $uid && !data.exists() && newData.child('status').val() === '蟇ｩ譟ｻ荳ｭ'))",
          ".validate": "newData.hasChildren(['status', 'updatedAt']) && newData.child('status').isString() && newData.child('updatedAt').isNumber()"
        },

        "bank_account": {
          ".read": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['bankName', 'bankBranch', 'accountType', 'accountNumber', 'accountHolder'])"
        }
      }
    },

    "products": {
      "$productId": {
        ".read": true,

        ".write": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || (!data.exists() && newData.child('sellerUid').val() === auth.uid))",

        ".validate": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || (newData.hasChildren(['sellerUid']) && newData.child('sellerUid').val() === auth.uid))"
      }
    },

    "purchase_requests": {
      ".read": false,
      ".write": false
    },

    "orders": {
      ".read": false,
      ".write": false
    },

    "support_tickets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

        ".write": "auth != null && auth.uid === $uid",

        "$ticketId": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

          ".write": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

          "messages": {
            "$messageId": {
              ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

              ".write": "auth != null && (auth.uid === $uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')"
            }
          }
        }
      }
    },

    "chat_rooms": {
      ".read": false,
      ".write": false
    },

    "reports": {
      "$reportId": {
        ".read": "auth != null && (data.child('reporterUid').val() === auth.uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

        ".write": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || newData.child('reporterUid').val() === auth.uid)"
      }
    },

    "withdrawals": {
      "$withdrawalId": {
        ".read": "auth != null && (data.child('sellerUid').val() === auth.uid || auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2')",

        ".write": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'"
      }
    },

    "admin_data": {
      ".read": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'",
      ".write": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'"
    },

    "sessions": {
      "$session_id": {
        ".read": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'",
        ".write": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' && ((!data.exists() && newData.child('status').val() === 'PENDING') || (data.exists() && data.child('status').val() === 'PENDING' && newData.child('status').val() === 'APPROVED' && newData.child('uid').val() === auth.uid && newData.child('createdAt').val() === data.child('createdAt').val() && data.child('createdAt').val() + 300000 > now))"
      }
    },

    "chats": {
      ".read": false,
      ".write": false
    },

    "admin_user_index": {
      "$uid": {
        ".read": "auth != null && auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2'",

        ".write": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || (auth.uid === $uid && !data.exists()))",

        ".validate": "auth != null && (auth.uid === 'AbcuCZXecHQZ7e2oJLeUnh5U3oz2' || (newData.hasChildren(['uid','name','email','kycStatus','status','createdAt']) && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email && newData.child('name').isString() && newData.child('email').isString() && newData.child('kycStatus').isString() && newData.child('status').isString() && newData.child('createdAt').isNumber()))"
      }
    }
  }
}
