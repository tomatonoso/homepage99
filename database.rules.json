{
  "rules": {
    ".read": false,
    ".write": false,

    "public": {
      ".read": true,
      ".write": false
    },

    "news": {
      ".read": true,
      ".write": false
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['uid']) && newData.child('uid').val() === $uid"
      }
    },

    "private_users": {
  "$uid": {
    ".read": false,
    ".write": "auth != null && auth.uid === $uid && !newData.child('kyc').exists() && !newData.child('bank_account').exists()",

    "email": {
      ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
      ".write": "auth != null && auth.uid === $uid"
    },

    "phone": {
      ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
      ".write": "auth != null && auth.uid === $uid"
    },

    "settings": {
      ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
      ".write": "auth != null && auth.uid === $uid"
    },

    "legacyIdentifiers": {
      ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
      ".write": "auth != null && auth.uid === $uid"
    },

    "kyc": {
      ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
      ".write": false,
      ".validate": false
    },

    "bank_account": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false,
      ".validate": false
    }
  }
},

  "products": {
  "$productId": {
    ".read": true,
    ".write": "auth != null && auth.token.admin === true",
    ".validate": "auth != null && auth.token.admin === true && (!newData.exists() || newData.hasChildren(['sellerUid']))"
  }
},

    "purchase_requests": {
      "$requestId": {
        ".read": "auth != null && (data.child('requesterUid').val() === auth.uid || data.child('sellerUid').val() === auth.uid || auth.token.admin === true)",
        ".write": "auth != null && (newData.child('requesterUid').val() === auth.uid || data.child('requesterUid').val() === auth.uid || auth.token.admin === true)"
      }
    },

    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('buyerUid').val() === auth.uid || data.child('sellerUid').val() === auth.uid || auth.token.admin === true)",
        ".write": "auth != null && (data.child('buyerUid').val() === auth.uid || data.child('sellerUid').val() === auth.uid || auth.token.admin === true)"
      }
    },

    "support_tickets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid",

        "$ticketId": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
          ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",

          "messages": {
            "$messageId": {
              ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
              ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
            }
          }
        }
      }
    },

   "chat_rooms": {
  "$roomId": {
    ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
    ".write": false,

    "members": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('chat_rooms').child($roomId).child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.val() === true) && newData.val() === true"
      }
    },

    "messages": {
      "$messageId": {
        ".read": "auth != null && root.child('chat_rooms').child($roomId).child('members').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('chat_rooms').child($roomId).child('members').child(auth.uid).val() === true && newData.child('senderUid').val() === auth.uid"
      }
    }
  }
},

    "reports": {
      "$reportId": {
        ".read": "auth != null && (data.child('reporterUid').val() === auth.uid || auth.token.admin === true)",
        ".write": "auth != null && (newData.child('reporterUid').val() === auth.uid || auth.token.admin === true)"
      }
    },

    "withdrawals": {
      "$withdrawalId": {
        ".read": "auth != null && (data.child('sellerUid').val() === auth.uid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true"
      }
    },

    "admin_data": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "sessions": {
      "$session_id": {
        ".read": false,
        ".write": false
      }
    },

    "chats": {
      ".read": false,
      ".write": false
    }
  }
}